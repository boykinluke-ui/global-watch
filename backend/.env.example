# Copy to .env and configure. Keep secrets out of source control.
GW_ENABLE_SCHEDULER=true
GW_AUTO_FIRST_RUN_IMPORT=true
GW_TIMEZONE=America/Chicago
GW_BRIEFING_HOUR=6
GW_BRIEFING_MINUTE=30
GW_INGEST_INTERVAL_MINUTES=60
GW_DB_PATH=./data/global_watch.db
GW_BOOTSTRAP_BUNDLED_DB=true
GW_PUBLIC_READ_ONLY=false

# ReliefWeb requires an approved appname before Read API calls.
RELIEFWEB_APPNAME=
